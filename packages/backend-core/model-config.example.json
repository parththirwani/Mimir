{
  "transport": {
    "url": "https://openrouter.ai/api/v1/chat/completions",
    "timeoutMs": 30000,
    "maxAttempts": 2
  },
  "useCases": {
    "chat_response": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 8000, "maxOutputTokens": 2048, "temperature": 0.7 },
    "classification": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 4000, "maxOutputTokens": 512, "temperature": 0.1 },
    "planning": { "model": "openai/gpt-4o-mini", "maxInputTokens": 4000, "maxOutputTokens": 1024, "temperature": 0.1 },
    "agent_execution": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 8000, "maxOutputTokens": 2048, "temperature": 0.7 },
    "agent_filter": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 4000, "maxOutputTokens": 256, "temperature": 0.1 },
    "dedup_judgment": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 4000, "maxOutputTokens": 256, "temperature": 0.1 },
    "email_proposal": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 4000, "maxOutputTokens": 1024, "temperature": 0.2 },
    "email_resolve": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 4000, "maxOutputTokens": 128, "temperature": 0.1 },
    "ack": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 4000, "maxOutputTokens": 128, "temperature": 0.8 },
    "surface": { "model": "~deepseek/deepseek-v4-flash-latest", "maxInputTokens": 8000, "maxOutputTokens": 2048, "temperature": 0.5 },
    "evaluation": { "model": "openai/gpt-4o-mini", "maxInputTokens": 4000, "maxOutputTokens": 512, "temperature": 0.1 },
    "fact_extraction": { "model": "openai/gpt-4o-mini", "maxInputTokens": 4000, "maxOutputTokens": 1024, "temperature": 0.1 },
    "fact_conflict": { "model": "openai/gpt-4o-mini", "maxInputTokens": 4000, "maxOutputTokens": 256, "temperature": 0.1 }
  },
  "embeddings": { "model": "openai/text-embedding-3-small" }
}