generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  streaming
  complete
  failed
}

enum AgentStatus {
  active
  dormant
  archived
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  createdAt    DateTime @default(now())

  conversations     Conversation[]
  agents            Agent[]
  connections       IntegrationConnection[]
  refreshTokens     RefreshToken[]
  usage             UsageRecord[]
  pushSubscriptions PushSubscription[]
  analyticsEvents   AnalyticsEvent[]
  modelCallLogs     ModelCallLog[]
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]
  summaries ConversationSummary[]

  @@index([userId])
}

model Message {
  id               String        @id @default(uuid())
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id])
  clientMessageId  String?
  role             MessageRole
  content          String        @db.Text
  status           MessageStatus @default(complete)
  toolCalls        Json?
  attachments      Json?
  parentMessageId  String?
  model            String?
  tokenCount       Int?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  errorDetail      Json?
  createdAt        DateTime      @default(now())
  editedAt         DateTime?

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}
model ConversationSummary {
  id                 String       @id @default(uuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  summaryText        String       @db.Text
  coversMessagesUpTo DateTime
  createdAt          DateTime     @default(now())

  @@index([conversationId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Agent {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  ownerConversationId String
  taskDescription     String      @db.Text
  entity              String?
  status              AgentStatus @default(active)
  embedding           Unsupported("vector(1536)")? // needs CREATE EXTENSION vector (hand-added to init migration); client access via $queryRaw only
  contextSummary      String?     @db.Text // folded-in summary of older AgentEvents once the per-agent context budget (40 events / 8k tokens) is exceeded
  lastActiveAt        DateTime    @default(now())
  createdAt           DateTime    @default(now())
  events              AgentEvent[]

  @@index([userId, status])
}

model AgentEvent {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
}

model IntegrationConnection {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  provider          String
  nangoConnectionId String   @unique
  status            String
  createdAt         DateTime @default(now())

  @@index([userId, provider])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String
  rawPayload  Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json
  platform  String
  createdAt DateTime @default(now())
}

model UsageRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  tokensUsed Int      @default(0)

  @@unique([userId, date])
}
model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  eventType  String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model ModelCallLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  useCase        String   // "chat_response" | "classification" | "agent_execution" | "summarization" | "embeddings"
  model          String   // model requested per model-config.json
  actualModel    String?  // model that actually served the request (response.model) — differs from `model` when the fallback chain triggered
  tokensUsed     Int      // total_tokens
  promptTokens   Int?
  completionTokens Int?
  cachedTokens   Int?     // usage.prompt_tokens_details.cached_tokens — prompt-cache hit signal
  finishReason   String?  // normalized finish_reason ("stop" | "length" | "content_filter" | "tool_calls" | "error")
  generationId   String?  // OpenRouter's response id — lets you query /api/v1/generation later for provider-level audit detail
  costCents      Int
  latencyMs      Int
  success        Boolean
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([model, createdAt])
}
