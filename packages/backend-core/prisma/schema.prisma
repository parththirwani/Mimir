generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  streaming
  complete
  failed
}

enum AgentStatus {
  active
  dormant
  archived
}

enum AgentComplexity {
  simple
  complex
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  timezone     String?
  createdAt    DateTime @default(now())

  conversations     Conversation[]
  agents            Agent[]
  connections       IntegrationConnection[]
  mcpServers        McpServer[]
  refreshTokens     RefreshToken[]
  usage             UsageRecord[]
  pushSubscriptions PushSubscription[]
  analyticsEvents   AnalyticsEvent[]
  modelCallLogs     ModelCallLog[]
  surfacedMails     SurfacedMail[]
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]
  summaries ConversationSummary[]
  facts     ExtractedFact[]

  @@index([userId])
}

model Message {
  id               String        @id @default(uuid())
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id])
  clientMessageId  String?
  role             MessageRole
  content          String        @db.Text
  status           MessageStatus @default(complete)
  toolCalls        Json?
  attachments      Json?
  parentMessageId  String?
  model            String?
  tokenCount       Int?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  errorDetail      Json?
  createdAt        DateTime      @default(now())
  editedAt         DateTime?

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}
model ConversationSummary {
  id                 String       @id @default(uuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  summaryText        String       @db.Text
  coversMessagesUpTo DateTime
  createdAt          DateTime     @default(now())

  @@index([conversationId])
}

// Flat, atomically-retrievable durable facts extracted from
// the thread, alongside the narrative ConversationSummary (see fact-extraction.ts).
// `status` is a plain string (not a PG enum) because it keeps gaining states —
// active | superseded | deleted — and each addition would otherwise require an
// ALTER TYPE migration. Enforce the allowed set with a TS union at call sites.
//
// Supersede-scan semantics differ deliberately from delete:
//   - supersede: "this fact CHANGED" — old fact PRESERVED + excluded from reads,
//     full history kept (temporal queries); new fact's supersedesId points here.
//   - delete: "this fact should never have been stored / remove it" — status flip,
//     excluded from EVERY read path, never resurfaces, row kept only for audit.
model ExtractedFact {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  subject        String
  fact           String   @db.Text
  embedding      Unsupported("vector(1536)")? // raw $executeRaw access only (mirrors Agent.embedding)
  factSearch     Unsupported("tsvector")? // generated to_tsvector('english', subject || ' ' || fact); raw SQL only (see migration)
  status         String   @default("active") // active | superseded | deleted
  // open string sets (no PG enum), typed at call sites
  subjectType    String   @default("other") // person | project | preference | date | credential | other
  factType       String   @default("attribute") // attribute | event | relationship | instruction
  sourceMessageId String?
  supersedesId   String?
// SetNull assumes no hard-purge path exists — supersede chains stay
  // soft-deleted (status flip). Rows are never physically removed, so the FK
  // always resolves to an existing (deleted) row.
  supersedes     ExtractedFact?  @relation("FactSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   ExtractedFact[] @relation("FactSupersedes")
  outgoingRelations FactRelation[] @relation("FactRelationSource")
  incomingRelations FactRelation[] @relation("FactRelationTarget")
  deletedAt      DateTime?
  deletedReason  String? // incorrect_extraction | user_requested | manual_correction
  createdAt      DateTime @default(now())

  @@index([conversationId, status])
  @@index([conversationId, subject])
}

// Directed fact-to-fact edge (fact graph). `relationType` is a free text tag
// (e.g. "affects", "predecessor_of", "example_of"), not an enum — set only by
// the extraction relation pass, never user-typed. Both FKs indexed for the
// bidirectional expansion in searchActiveFactsWithRelations.
model FactRelation {
  id              String   @id @default(uuid())
  sourceFactId    String
  targetFactId    String
  relationType    String
  sourceMessageId String?
  createdAt       DateTime @default(now())

  sourceFact ExtractedFact @relation("FactRelationSource", fields: [sourceFactId], references: [id])
  targetFact ExtractedFact @relation("FactRelationTarget", fields: [targetFactId], references: [id])

  @@index([sourceFactId])
  @@index([targetFactId])
}

// 13.5 — human-gated retrieval tuning proposal. tuneRetrievalParams aggregates
// recent eval runs into bounded, evidence-linked param adjustments; a human
// reviews and either rejects (status: rejected) or applies (runner writes the
// new value into model-config.json and sets status: applied). Never auto-applied.
model RetrievalTuningProposal {
  id            String   @id @default(uuid())
  param         String
  oldValue      Float
  newValue      Float
  evidenceRunIds String[] @default([])
  rationale     String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  appliedAt     DateTime?

  @@index([status, createdAt])
}
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Agent {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  ownerConversationId String
  taskDescription     String      @db.Text
  entity              String?
  status              AgentStatus @default(active)
  // Complexity gate: decided once at spawn by the classification call. Only
  // `complex` agents route through the reflector.
  complexity          AgentComplexity @default(simple)
  embedding           Unsupported("vector(1536)")? // needs CREATE EXTENSION vector (hand-added to init migration); client access via $queryRaw only
  contextSummary      String?     @db.Text // folded-in summary of older AgentEvents once the per-agent context budget (40 events / 8k tokens) is exceeded
  lastActiveAt        DateTime    @default(now())
  createdAt           DateTime    @default(now())
  events              AgentEvent[]
  reflectionEvents    ReflectionEvent[]
  plans               Plan[]
  triggers            Trigger[]

  @@index([userId, status])
}

// Planning: one row per planned complex run. `steps` is the planner's ordered,
// dependency-resolved JSON. status tracks the run so a replan can mark the
// failed plan before retrying. agentId stays required — one-shot runs skip
// planning entirely (they have no Agent to own the plan).
model Plan {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  steps     Json
  status    String   @default("planned") // planned | running | completed | failed
  createdAt DateTime @default(now())

  @@index([agentId])
}

model AgentEvent {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

// Reflector: one row per failed evaluation on a complex run.
// Kept separate from AgentEvent so reflection noise doesn't pollute the agent's
// working context once a final answer is reached. `agentId` stays required —
// one-shot runs (no Agent) skip the DB write, not the column.
model ReflectionEvent {
  id            String   @id @default(uuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  attemptNumber Int
  score         Float
  feedback      String   @db.Text
  createdAt     DateTime @default(now())

  @@index([agentId, createdAt])
}

// First-class triggers: a natural-language condition scoped to its owning
// agent, evaluated by the 1-min scheduler tick. Created via cheap-model
// classification; re-checked at fire time by the owning agent before it
// acts. `criteria` is the natural-language condition, not a cron expression —
// `schedule` is reserved for future user-supplied cadences.
model Trigger {
  id          String    @id @default(uuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  name        String
  criteria    String    @db.Text
  schedule    String?
  enabled     Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([agentId, enabled])
  @@index([enabled])
}
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
}

// Durable, Postgres-claimed dedup for surfaced mail (the source of truth in
// addition to the Redis set). A unique primary key on messageId means a re-poll
// can NEVER re-surface the same email, even if Redis was flushed or a scale-out
// worker re-ran the sweep. The crew's in-flight atomic claim is still the Redis
// set; this row records the durable claim once surfaced.
model SurfacedMail {
  messageId String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User-supplied MCP servers: separate settings section, streamable-HTTP
// transport ONLY. stdio is intentionally off the table for user-added servers —
// it spawns an arbitrary binary on our infrastructure (arbitrary code exec).
// The tool schema is fetched + cached at registration; runtime failures map to
// generic ConnectionError/ToolError only (we don't control the server).
model McpServer {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  name         String
  url          String
  headers      Json?
  toolSchema   Json? // cached {name, description, inputSchema}[] from tools/list
  status       String    @default("pending") // pending | connected | error
  lastError    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model IntegrationConnection {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  provider String
  // Opaque upstream connection id: the Nango connection_id OR the Composio
  // connected_account id. Provider-agnostic — either provider stores its id here.
  connectionId String @unique
  status       String
  createdAt    DateTime @default(now())

  @@index([userId, provider])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String
  rawPayload  Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json
  platform  String
  createdAt DateTime @default(now())
}

model UsageRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  tokensUsed Int      @default(0)

  @@unique([userId, date])
}
model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  eventType  String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model ModelCallLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  useCase        String   // "chat_response" | "classification" | "agent_execution" | "summarization" | "embeddings"
  model          String   // model requested per model-config.json
  actualModel    String?  // model that actually served the request (response.model) — differs from `model` when the fallback chain triggered
  tokensUsed     Int      // total_tokens
  promptTokens   Int?
  completionTokens Int?
  cachedTokens   Int?     // token: usage.prompt_tokens_details.cached_tokens — prompt-cache hit signal
  finishReason   String?  // normalized finish_reason ("stop" | "length" | "content_filter" | "tool_calls" | "error")
  generationId   String?  // OpenRouter's response id — lets you query /api/v1/generation later for provider-level audit detail
  costCents      Int
  latencyMs      Int
  success        Boolean
  // 10.7 context snapshot: hashes + the structure (message ids, injected block
  // ids) of what was fed to the call. References only — text itself is not
  // duplicated here (it lives in the source tables).
  systemPromptHash String?
  injectedBlocks   Json? // ordered [{type, refIds}] — retrieved facts/events injected
  messageWindow    Json? // ordered message ids that formed the call's context
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([model, createdAt])
}
