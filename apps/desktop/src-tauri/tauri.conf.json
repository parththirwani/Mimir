{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir",
  "version": "0.1.0",
  "identifier": "app.mimir.desktop",
  "build": {
    "beforeDevCommand": "echo 'web runs via turbo dev on :3000'",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Mimir",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Mimir desktop"
  }
}