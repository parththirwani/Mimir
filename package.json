{
  "name": "mimir",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "verify": "bun run scripts/verify-no-duplication.ts",
    "classify": "bun scripts/intent-iteration/run-classify.ts",
    "phase7-attack": "bun scripts/phase7-attack/run.ts",
    "phase8-attack": "bun scripts/phase8-attack/run.ts",
    "phase10-facts": "bun scripts/phase10-facts/run.ts",
    "migrate": "bun scripts/migrate.ts",
    "eval-retrieval": "bun scripts/eval-retrieval.ts",
    "eval-query": "bun scripts/eval-query.ts",
    "eval-locomo": "bun scripts/eval-locomo.ts",
    "tune-retrieval": "bun scripts/tune-retrieval.ts",
    "iterate": "bun scripts/intent-iteration/run-e2e.ts",
    "intent": "bun scripts/intent-iteration/run-intent.ts"
  },
  "devDependencies": {
    "@composio/core": "^0.14.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.11"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
