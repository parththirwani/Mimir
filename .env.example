# Mimir environment config — validated by packages/backend-core (see config.schema.ts)
# Copy to .env and fill in. Only DATABASE_URL and REDIS_URL are required at boot;
# the rest are validated when their phase lands.

# Required at boot (Phase 0.3/0.4 health checks)
DATABASE_URL=
REDIS_URL=

# Phase 1 (auth, JWT)
JWT_SECRET=

# Phase 1.4 (OpenRouter)
OPENROUTER_API_KEY=

# Phase 5 (Nango OAuth provider)
NANGO_SECRET_KEY=

# Phase 1.2 (observability)
SENTRY_DSN=
