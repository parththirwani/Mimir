# Mimir environment config — validated by packages/backend-core (see config.schema.ts)
# Copy to .env and fill in. Only DATABASE_URL and REDIS_URL are required at boot;
# the rest are validated when their phase lands.

# Required at boot (Phase 0.3/0.4 health checks)
DATABASE_URL=
REDIS_URL=

JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WEB_APP_URL=
# API origin — integration OAuth callbacks (Composio) and Pub/Sub webhooks land
# here. Unset = falls back to WEB_APP_URL (breaks the gmail callback in dev).
PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=

OPENROUTER_API_KEY=

NANGO_SECRET_KEY=
NANGO_BASE_URL=

# Composio — primary Gmail connection provider (no connection caps). Set
# COMPOSIO_API_KEY to prefer Composio; the gmail factory falls back to Nango.
# Gmail API calls go through Composio's proxy-execute transport (credentials are
# injected server-side), so "Mask Connected Account Secrets" needs no special
# handling — Composio redacts connected-account secrets on every read endpoint,
# but no raw token is extracted by this app anymore.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=
COMPOSIO_GMAIL_AUTH_CONFIG=

# Optional: a user whose Gmail gmailRequest transport is exercised daily (canary)
# to catch a silent break in the provider's proxy path. Empty = no-op.
CONNECTION_CANARY_USER_ID=

BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Comma-separated domain allowlist for the browser task; empty = allow all (dev)
BROWSER_ALLOWED_DOMAINS=
# Comma-separated domain denylist; always blocks matching hostnames/subdomains
BROWSER_DENIED_DOMAINS=

SENTRY_DSN=

OTEL_EXPORTER_OTLP_HEADERS=

# Web Push (7.1) — generate with: bun x web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:your@email.com — contact for the push service
VAPID_SUBJECT=